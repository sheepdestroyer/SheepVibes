[Unit]
Description=SheepVibes App Container
After=sheepvibes-valkey.container sheepvibes-rssbridge.container
Requires=sheepvibes-valkey.container
Wants=sheepvibes-rssbridge.container

[Container]
ContainerName=sheepvibes-app
Image=ghcr.io/sheepdestroyer/sheepvibes:latest
Pull=always
AutoUpdate=registry
Pod=sheepvibespod.pod
Volume=sheepvibes-db.volume:/app/data
Environment=DATABASE_PATH=/app/data/sheepvibes.db
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/', timeout=3)"
HealthInterval=15s
HealthTimeout=10s
HealthRetries=3
Environment=CACHE_VALKEY_URL=redis://localhost:6379/0
Environment=CACHE_REDIS_URL=redis://localhost:6379/0
Environment=RSS_BRIDGE_URL=http://localhost:80
Environment=FLASK_APP=backend.app
Environment=PYTHONPATH=/app
Environment=UPDATE_INTERVAL_MINUTES=15
Environment=FLASK_RUN_HOST=0.0.0.0

[Service]
Restart=on-failure
TimeoutStartSec=180
